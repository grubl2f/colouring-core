{
    "compilerOptions": {
        "outDir": "./build",
        "allowJs": true,
        "module": "es2020",
        "target": "es2017",
        "jsx": "react",
        "lib": ["es2017", "dom"],
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "noImplicitAny": false
    },
    "include": ["src"]
}
